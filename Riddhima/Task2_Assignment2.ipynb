# ============================================================
# METRICS
# ============================================================

def compute_metrics(y, y_hat):
    """
    Compute the following metrics:

    1. Mean Squared Error (MSE)

        MSE = mean((y - y_hat)^2)

    2. Correlation

    3. Squared Correlation

    4. R^2 score
    """

    # TODO
    MSE  = np.mean((y- y_hat)*(y- y_hat))
    matrix = np.corrcoef(y, y_hat)
    corr = matrix[0,1]
    squared = corr*corr 
    score = r2_score(y, y_hat)
    return MSE, corr, squared, score
    raise NotImplementedError


