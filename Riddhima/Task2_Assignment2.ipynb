import numpy as np
from sklearn.metrics import r2_score
# ============================================================
# OLS IMPLEMENTATIONS
# ============================================================

def ols_with_intercept(X, y):
    """
    Ordinary Least Squares WITH intercept.

    Parameters
    ----------
    X : numpy array (N,d)
        Feature matrix

    y : numpy array (N,)
        Target values

    Returns
    -------
    w  : slope vector (d,)
    w0 : intercept scalar
    """

    # TODO:
    # Step 1: Add a column of ones to X to represent intercept
    N = X.shape[0]
    extra = np.ones(N)
    X = np.insert(X,0, extra, axis=1 )
    # Step 2: Use the normal equation
    #
    #        w = (X^T X)^(-1) X^T y
    w1 = (np.linalg.inv(np.transpose(X) @ X))@(np.transpose(X))@(y)
    # Step 3: Separate intercept from weight vector
    w0 = w1[0]
    w = w1[1:]
    return(w,w0)

    raise NotImplementedError


def ols_no_intercept(X, y):
    """
    OLS WITHOUT intercept.

    Use the normal equation:

        w = (X^T X)^(-1) X^T y
    """

    # TODO:
    w = (np.linalg.inv(np.transpose(X) @ X))@(np.transpose(X))@(y)
    return w
    # Implement closed-form solution

